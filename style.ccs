<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SONOLOX | Accueil</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-glow: #00f2ff;
            --secondary-glow: #ffffff;
            --font-main: 'Montserrat', sans-serif;
        }

        body, html {
            margin: 0; padding: 0; height: 100%; width: 100%;
            font-family: var(--font-main); background-color: #000;
            color: #fff; display: flex; flex-direction: column;
            align-items: center; justify-content: flex-start; 
            overflow: hidden; padding-top: 20px;
        }

        .header-section {
            text-align: center; margin-bottom: 15px; z-index: 100;
            animation: fadeInDown 1s ease forwards;
        }

        .logo-sonolox {
            width: 380px; max-width: 75vw; height: auto;
            filter: drop-shadow(0px 0px 20px rgba(255, 255, 255, 0.1));
            display: block; margin: 0 auto 10px auto;
        }

        .tagline {
            font-size: 1rem; font-weight: 300; letter-spacing: 4px;
            text-transform: uppercase; color: rgba(255, 255, 255, 0.85);
            margin: 0; line-height: 1.4;
        }

        .tagline span { display: block; font-weight: 700; color: #fff; letter-spacing: 6px; }

        .screen-container {
            position: relative; width: 90%; max-width: 1000px;
            aspect-ratio: 21 / 9; background-color: #111;
            border-radius: 4px; box-shadow: 0 0 50px rgba(0, 0, 0, 1);
            overflow: hidden; border: 1px solid #222;
            animation: fadeInUp 1s ease forwards;
        }

        .hero-bg {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url('https://i.ibb.co/Z6tRCfBJ/IMG-8976.jpg');
            background-size: cover; background-position: center 20%; 
            filter: brightness(0.4) contrast(1.1); z-index: 1;
        }

        .content-overlay {
            position: relative; z-index: 2; width: 100%; height: 100%;
            display: flex; align-items: flex-end; justify-content: center;
            padding: 30px; box-sizing: border-box;
        }

        .cta-section {
            display: flex; gap: 25px; justify-content: center;
            width: 100%; max-width: 750px;
        }

        /* --- STYLE DES BOUTONS NÉON --- */
        .cta-btn {
            flex: 1; padding: 18px 25px; font-size: 0.85rem;
            font-weight: 700; text-transform: uppercase;
            text-decoration: none; letter-spacing: 2px;
            border-radius: 2px; text-align: center;
            white-space: nowrap; transition: 0.4s;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(10px);
        }

        /* Animation Néon Clignotante (5 secondes) */
        @keyframes neonFlicker {
            0%, 2%, 4%, 6% { opacity: 0.6; box-shadow: none; border-color: rgba(255,255,255,0.1); }
            1%, 3%, 5% { opacity: 1; border-width: 1px; }
            7%, 92% { opacity: 1; }
            93% { opacity: 0.6; }
            94% { opacity: 1; }
            95% { opacity: 0.8; }
            96% { opacity: 1; }
        }

        .btn-dj {
            color: var(--primary-glow);
            border: 1px solid var(--primary-glow);
            box-shadow: 0 0 15px rgba(0, 242, 255, 0.3);
            animation: neonFlicker 5s infinite;
        }

        .btn-dj:hover {
            background: var(--primary-glow); color: #000;
            box-shadow: 0 0 35px var(--primary-glow);
            transform: translateY(-3px); animation: none;
        }

        .btn-event {
            color: var(--secondary-glow);
            border: 1px solid var(--secondary-glow);
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
            animation: neonFlicker 5s infinite 0.5s;
        }

        .btn-event:hover {
            background: var(--secondary-glow); color: #000;
            box-shadow: 0 0 35px var(--secondary-glow);
            transform: translateY(-3px); animation: none;
        }

        /* --- FOOTER DISCRET --- */
        .footer-home {
            position: absolute;
            bottom: 20px;
            text-align: center;
            width: 100%;
            z-index: 100;
        }

        .company-id {
            font-size: 0.65rem;
            letter-spacing: 3px;
            color: rgba(255, 255, 255, 0.3);
            text-transform: uppercase;
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-50px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(50px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @media (max-width: 768px) {
            .screen-container { aspect-ratio: auto; height: 45vh; width: 92%; }
            .logo-sonolox { width: 280px; }
            .tagline { font-size: 0.75rem; }
            .cta-section { flex-direction: column; gap: 15px; }
            .cta-btn { padding: 15px; }
        }
    </style>
</head>
<body>

    <header class="header-section">
        <img src="https://i.ibb.co/k6Xb6j2y/Sonolox-Logo-blanc.png" alt="SONOLOX" class="logo-sonolox">
        <p class="tagline">
            Votre demande sur mesure ?
            <span>C’est possible !</span>
        </p>
    </header>

    <main class="screen-container">
        <div class="hero-bg"></div>
        <div class="content-overlay">
            <div class="cta-section">
                <a href="dj.html" class="cta-btn btn-dj">DJ SONOLOX</a>
                <a href="event.html" class="cta-btn btn-event">SONOLOX ÉVÉNEMENT</a>
            </div>
        </div>
    </main>

    <footer class="footer-home">
        <span class="company-id">BE0792.728.837</span>
    </footer>

</body>
</html>
